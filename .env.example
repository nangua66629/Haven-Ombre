# Haven-Ombre runtime settings
# Copy to .env on the server. Never commit the real .env file.

OMBRE_DASHBOARD_PASSWORD=replace_with_a_long_random_password
OMBRE_API_KEY=replace_with_provider_api_key

# ChatGPT / Codex MCP OAuth 2.1
# DCR + PKCE are automatic; fixed OAuth client credentials are not required.
OMBRE_CHATGPT_OAUTH_DYNAMIC=true
OMBRE_CHATGPT_OAUTH_PUBLIC_BASE_URL=https://your-ombre-host.example.com

# Optional explicit private-state directory. The default is
# <buckets_dir>/.private, which must stay on the persistent volume.
# OMBRE_OAUTH_STATE_DIR=/app/buckets/.private
